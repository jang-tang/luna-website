# 실제 값은 .env / .env.local (git 제외) 또는 배포 플랫폼의 Secret 에 넣는다.

# --- DB (PostgreSQL) ---
POSTGRES_PASSWORD=            # docker-compose 의 postgres 컨테이너 비밀번호 (compose 사용 시)
DATABASE_URL=                 # postgres://user:password@host:5432/luna
DATABASE_POOL_MAX=5           # 커넥션 풀 크기 (로컬 PGlite 는 1)
DATABASE_SSL=prefer           # disable | require | prefer
DATABASE_PREPARE=true         # pgbouncer transaction 모드/로컬 PGlite 는 false

# --- Notion ---
NOTION_TOKEN=                 # Notion 통합(Integration) 토큰 — 서버 전용
NOTION_ROOT_PAGE_ID=          # 부트스트랩 시 DB 를 만들 부모 페이지
NOTION_MEMBERS_DATA_SOURCE_ID=
NOTION_AWARDS_DATA_SOURCE_ID=
NOTION_PROJECTS_DATA_SOURCE_ID=
NOTION_QNA_DATA_SOURCE_ID=
NOTION_SETTINGS_DATA_SOURCE_ID=
NOTION_REQUESTS_PER_SECOND=2.5

# --- 동기화 ---
SYNC_SECRET=                  # 32자 이상 랜덤 (openssl rand -hex 32)
CRON_SECRET=                  # Vercel Cron 사용 시
SYNC_INTERVAL_MINUTES=15
SYNC_LOCK_TTL_MINUTES=15
APP_URL=                      # CLI/스케줄러가 캐시 무효화를 요청할 앱 주소

# --- 관리 페이지 (/admin/sync, 미설정 시 404) ---
ADMIN_USER=admin
ADMIN_PASSWORD=               # 12자 이상

SITE_URL=                      # 운영 사이트 주소 (예: https://example.com) — canonical/og:url 에 사용. luna.codes 는 탈취되어 사용 금지
SITE_HOST=                     # docker-compose.traefik.yml 사용 시 Traefik 라우팅 도메인 (예: example.com)
LOG_LEVEL=info
